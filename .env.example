# Copia este archivo a .env y rellena los valores reales (nunca subas .env a git).
# Formato: NOMBRE_VARIABLE=valor

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Puerto del host donde se expone Postgres (5432 si lo tienes libre; 5433 por defecto)
POSTGRES_PORT=5433

# Cadena de conexión para la app: postgresql://USUARIO:PASSWORD@localhost:PUERTO/BASE_DE_DATOS
DATABASE_URL=
